<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.vanderson.worklog.summary</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__WORKLOG_DIR__/bin/daily_summary.py</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>18</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>WorkingDirectory</key>
  <string>__WORKLOG_DIR__</string>
  <key>StandardOutPath</key>
  <string>__WORKLOG_DIR__/logs/summary.out.log</string>
  <key>StandardErrorPath</key>
  <string>__WORKLOG_DIR__/logs/summary.err.log</string>
</dict>
</plist>
