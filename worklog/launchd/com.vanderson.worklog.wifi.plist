<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.vanderson.worklog.wifi</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__WORKLOG_DIR__/bin/wifi_watch.py</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>WorkingDirectory</key>
  <string>__WORKLOG_DIR__</string>
  <key>StandardOutPath</key>
  <string>__WORKLOG_DIR__/logs/wifi_watch.out.log</string>
  <key>StandardErrorPath</key>
  <string>__WORKLOG_DIR__/logs/wifi_watch.err.log</string>
</dict>
</plist>
